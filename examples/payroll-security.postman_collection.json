{
  "info": {
    "name": "Payroll local demo security",
    "description": "HTTPS Gateway examples. Trust .local/localhost.crt in Postman. Run Security checks in order. Optional workflow writes change demo data. No external identity provider.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "https://localhost:8080",
      "type": "string"
    },
    {
      "key": "employeeId",
      "value": "EMP001",
      "type": "string"
    },
    {
      "key": "adjustmentId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "statementPeriodId",
      "value": "1",
      "type": "string"
    },
    {
      "key": "clerkPassword",
      "value": "Clerk@123",
      "type": "string"
    },
    {
      "key": "approverPassword",
      "value": "Approver@123",
      "type": "string"
    },
    {
      "key": "clerkToken",
      "value": "",
      "type": "string"
    },
    {
      "key": "approverToken",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "Security checks",
      "item": [
        {
          "name": "Login clerk",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"clerk\",\n  \"password\": \"{{clerkPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"clerkToken\", pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Login approver",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/auth/token",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "auth",
                "token"
              ]
            },
            "auth": {
              "type": "noauth"
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"approver\",\n  \"password\": \"{{approverPassword}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });",
                  "if (pm.response.code === 200) { pm.collectionVariables.set(\"approverToken\", pm.response.json().accessToken); }"
                ]
              }
            }
          ]
        },
        {
          "name": "Anonymous read returns 401",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "{{employeeId}}"
              ]
            },
            "auth": {
              "type": "noauth"
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 401\", function () { pm.response.to.have.status(401); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Clerk reads EMP001",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "{{employeeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approver reads original snapshots",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/pay-periods/employees/{{employeeId}}/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pay-periods",
                "employees",
                "{{employeeId}}",
                "snapshots"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{approverToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 200\", function () { pm.response.to.have.status(200); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Unauthorized employee returns 403",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/EMP999",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "EMP999"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Clerk approval returns 403",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/retro-adjustments/employees/{{employeeId}}/{{adjustmentId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "retro-adjustments",
                "employees",
                "{{employeeId}}",
                "{{adjustmentId}}",
                "approve"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Approver backdate returns 403",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/{{employeeId}}/HOUSING/backdate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "{{employeeId}}",
                "HOUSING",
                "backdate"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{approverToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": 1,\n  \"monthlyAmount\": 3000,\n  \"effectiveFrom\": \"2026-08-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        },
        {
          "name": "Editing issued snapshot returns 403",
          "request": {
            "method": "PATCH",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/pay-periods/employees/{{employeeId}}/{{statementPeriodId}}/snapshots",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "pay-periods",
                "employees",
                "{{employeeId}}",
                "{{statementPeriodId}}",
                "snapshots"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"originalAmount\": 3000\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"HTTP 403\", function () { pm.response.to.have.status(403); });"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "Optional workflow writes",
      "description": "These requests change demo data. Update adjustmentId before approving. Repeat creates/backdates can return 409.",
      "item": [
        {
          "name": "Create TRAVEL rule once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "{{employeeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"allowanceType\": \"TRAVEL\",\n  \"monthlyAmount\": 2000,\n  \"effectiveFrom\": \"2026-08-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Backdate seeded HOUSING once",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/allowances/employees/{{employeeId}}/HOUSING/backdate",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "allowances",
                "employees",
                "{{employeeId}}",
                "HOUSING",
                "backdate"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{clerkToken}}",
                  "type": "string"
                }
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"expectedVersion\": 1,\n  \"monthlyAmount\": 3000,\n  \"effectiveFrom\": \"2026-08-01\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "Read generated adjustments",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/retro-adjustments/employees/{{employeeId}}",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "retro-adjustments",
                "employees",
                "{{employeeId}}"
              ]
            },
            "auth": {
              "type": "bearer",
              "bearer": [
                {
                  "key": "token",
                  "value": "{{approverToken}}",
                  "type": "string"
                }
              ]
            }
          },
          "response": []
        },
        {
          "name": "Approve actual draft adjustment",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/retro-adjustments/employees/{{employeeId}}/{{adjustmentId}}/approve",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "retro-adjustments",
                "employees",
                "{{employeeId}}",
                "{{adjustmentId}}",
